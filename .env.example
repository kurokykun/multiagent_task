# Copia este fichero a .env (no se versiona) y rellena tu clave.

# --- Opción A: OpenAI ---
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Opción B: Ollama local (docker compose --profile local up) ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBEDDINGS_MODEL=nomic-embed-text

# --- Opción C: sin embeddings remotos (hashing local, sin red) ---
# EMBEDDINGS_PROVIDER=local

# Límites por petición
REQUEST_TIMEOUT_S=45
REQUEST_TOKEN_BUDGET=6000
LLM_MAX_TOKENS_PER_CALL=800
SQL_MAX_ROWS=200
SQL_MAX_RETRIES=2
